RIPT_API_URL=https://ript-backend-production.up.railway.app
PORT=4315
GACHA_SANDBOX_KEY=
GACHA_LIVE_KEY=
SANDBOX_RPC_URL=https://api.devnet.solana.com
LIVE_RPC_URL=https://api.devnet.solana.com

# Distinct optional service credentials. Never reuse setup owner sessions.
INVENTORY_SANDBOX_KEY=
INVENTORY_LIVE_KEY=
INVENTORY_SANDBOX_MUTATIONS=false
INVENTORY_LIVE_MUTATIONS=false
COLLECTOR_SESSION_TOKEN=
PARTNER_SESSION_TOKEN=

# Physical shipment requires explicitly approved non-synthetic fixtures.
FULFILMENT_APPROVED_CLAIM_IDS=

# Independent SDK examples: see examples/server/.env.example.
# Treasury is derived from the matching Gacha credential; no project address is hardcoded.

# Optional account setup: explicitly supply your own identity
DEVELOPER_EMAIL=
DEVELOPER_DISPLAY_NAME=
